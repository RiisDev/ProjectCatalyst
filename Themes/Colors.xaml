<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundTopColor">#0A0E1A</Color>
    <Color x:Key="BackgroundBottomColor">#141B2E</Color>
    <Color x:Key="PanelColor">#1C2436</Color>
    <Color x:Key="PanelBorderColor">#2A3348</Color>
    <Color x:Key="AccentColor">#00C2FF</Color>
    <Color x:Key="TextPrimaryColor">#F5F7FA</Color>
    <Color x:Key="TextSecondaryColor">#8792A6</Color>

    <Color x:Key="QuestionColor">#7C5CFF</Color>
    <Color x:Key="WarningColor">#FFB05C</Color>
    <Color x:Key="ErrorColor">#FF5C7C</Color>

    <SolidColorBrush x:Key="BackgroundTopBrush" Color="{StaticResource BackgroundTopColor}" />
    <SolidColorBrush x:Key="BackgroundBottomBrush" Color="{StaticResource BackgroundBottomColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="QuestionBrush" Color="{StaticResource QuestionColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{StaticResource BackgroundTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundBottomColor}" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
