<UserControl x:Class="ProjectCatalyst.Views.Consoles.Ps3ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:internals="clr-namespace:ProjectCatalyst.Views.Consoles.Internals"
             xmlns:views="clr-namespace:ProjectCatalyst.Views"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Focusable="True">

    <UserControl.Resources>

        <DataTemplate x:Key="UsersIconTemplate">
            <Grid Width="40" Height="40">
                <Ellipse Width="16" Height="16" Stroke="White" StrokeThickness="2"
                         VerticalAlignment="Top" HorizontalAlignment="Center" />
                <Border Width="30" Height="16" CornerRadius="15,15,0,0"
                        BorderBrush="White" BorderThickness="2"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GameIconTemplate">
            <Grid Width="44" Height="32">
                <Border CornerRadius="14" BorderBrush="White" BorderThickness="2" Background="Transparent" />
                <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0" />
                <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,6" />
                <Rectangle Width="12" Height="2" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0" />
                <Rectangle Width="2" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PhotoIconTemplate">
            <Grid Width="38" Height="30" ClipToBounds="True">
                <Border BorderBrush="White" BorderThickness="2" CornerRadius="2" />
                <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,5,0,0" />
                <Polygon Points="2,26 12,10 20,20 27,8 36,26"
                         Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MusicIconTemplate">
            <Grid Width="30" Height="38">
                <Ellipse Width="12" Height="9" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Rectangle Width="2" Height="34" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" />
                <Polygon Points="12,0 26,6 12,12" Fill="White" />
            </Grid>
        </DataTemplate>

		<DataTemplate x:Key="SettingsIconTemplate">
			<TextBlock Text="&#x2699;" FontSize="34" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
		</DataTemplate>

	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="0.7*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="1.3*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid.Background>
			<LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
				<GradientStop Color="#3D4A6B" Offset="0" />
				<GradientStop Color="#6B5A8F" Offset="0.55" />
				<GradientStop Color="#4A3D6B" Offset="1" />
			</LinearGradientBrush>
		</Grid.Background>

		<MediaElement x:Name="BackgroundVideo"
                      Grid.RowSpan="5"
                      Stretch="UniformToFill"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Volume="0"
                      IsHitTestVisible="False"
                      MediaEnded="OnBackgroundVideoEnded"
                      MediaFailed="OnBackgroundVideoFailed" />

		<MediaElement x:Name="BackgroundAudio"
                      Grid.Row="0"
                      Height="0"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Volume="0.4"
                      IsHitTestVisible="False"
                      MediaEnded="OnBackgroundAudioEnded"
                      MediaFailed="OnBackgroundAudioFailed" />

		<MediaElement x:Name="InputAudio"
		              Grid.Row="0"
		              Height="0"
		              LoadedBehavior="Manual"
		              UnloadedBehavior="Manual"
		              Volume="1"
		              MediaFailed="OnBackgroundAudioFailed"
		              IsHitTestVisible="False" />

		<Border Grid.Row="0" Grid.RowSpan="5" Background="#22140A2E" />

		<Border Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,36,0,0"
                Width="480"
                Height="44"
                Background="#33707070"
                BorderBrush="#40FFFFFF"
                BorderThickness="1,1,0,1"
                CornerRadius="4,0,0,4"
                Padding="20,0">
			<Grid>
				<TextBlock x:Name="CurrentUserText"
                           Text="Guest"
                           Foreground="White"
                           FontFamily="Segoe UI Light, Segoe UI"
                           FontSize="15"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
					<TextBlock x:Name="DateText"
                               Foreground="White"
                               FontFamily="Segoe UI Light, Segoe UI"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
					<TextBlock x:Name="ClockText"
                               Foreground="White"
                               FontFamily="Segoe UI Light, Segoe UI"
                               FontSize="15"
                               VerticalAlignment="Center" />
				</StackPanel>
			</Grid>
		</Border>

		<ItemsControl x:Name="CategoryList" Grid.Row="2" HorizontalAlignment="Center">
			<ItemsControl.Effect>
				<BlurEffect x:Name="CategoryBlur" Radius="0" />
			</ItemsControl.Effect>
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<StackPanel Margin="22,0" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
						<StackPanel.RenderTransform>
							<ScaleTransform x:Name="CategoryScale" ScaleX="1" ScaleY="1" />
						</StackPanel.RenderTransform>

						<Grid Width="60" Height="60">
							<Ellipse x:Name="FocusHalo" Width="60" Height="60" Opacity="0">
								<Ellipse.Fill>
									<RadialGradientBrush>
										<GradientStop Color="#00000000" Offset="0" />
										<GradientStop Color="#00000000" Offset="1" />
									</RadialGradientBrush>
								</Ellipse.Fill>
							</Ellipse>

							<Image x:Name="IconHost"
							       Source="{Binding IconPath}"
							       Height="90"
                                   Width="90"
							       Stretch="UniformToFill"
							       Focusable="False"
							       Opacity="0.4"
							       HorizontalAlignment="Center"
							       VerticalAlignment="Center" />
						</Grid>

						<TextBlock x:Name="CategoryLabel"
                                   Text="{Binding Name}"
                                   Foreground="White"
                                   FontFamily="Segoe UI Light, Segoe UI"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   Opacity="0" />
					</StackPanel>
					<DataTemplate.Triggers>
						<DataTrigger Binding="{Binding IsSelected}" Value="True">
							<Setter TargetName="IconHost" Property="Opacity" Value="1" />
							<Setter TargetName="CategoryLabel" Property="Opacity" Value="1" />
							<Setter TargetName="IconHost" Property="Effect">
								<Setter.Value>
									<DropShadowEffect Color="#3ECBFF" Direction="0" ShadowDepth="0" BlurRadius="16" Opacity="0.9" />
								</Setter.Value>
							</Setter>
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="CategoryScale"
                                                          Storyboard.TargetProperty="ScaleX"
                                                          To="1.15" Duration="0:0:0.15" />
										<DoubleAnimation Storyboard.TargetName="CategoryScale"
                                                          Storyboard.TargetProperty="ScaleY"
                                                          To="1.15" Duration="0:0:0.15" />
										<DoubleAnimation Storyboard.TargetName="FocusHalo"
                                                          Storyboard.TargetProperty="Opacity"
                                                          To="1" Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="CategoryScale"
                                                          Storyboard.TargetProperty="ScaleX"
                                                          To="1.0" Duration="0:0:0.15" />
										<DoubleAnimation Storyboard.TargetName="CategoryScale"
                                                          Storyboard.TargetProperty="ScaleY"
                                                          To="1.0" Duration="0:0:0.15" />
										<DoubleAnimation Storyboard.TargetName="FocusHalo"
                                                          Storyboard.TargetProperty="Opacity"
                                                          To="0" Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
					</DataTemplate.Triggers>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Rectangle x:Name="CategoryStreak"
                   Grid.Row="2"
                   Width="220" Height="90"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Opacity="0">
			<Rectangle.Fill>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
					<GradientStop Color="#003ECBFF" Offset="0" />
					<GradientStop Color="#803ECBFF" Offset="0.5" />
					<GradientStop Color="#003ECBFF" Offset="1" />
				</LinearGradientBrush>
			</Rectangle.Fill>
			<Rectangle.RenderTransform>
				<TranslateTransform x:Name="CategoryStreakTransform" X="0" />
			</Rectangle.RenderTransform>
		</Rectangle>

		<Border x:Name="ItemsViewport" Grid.Row="3" ClipToBounds="True" HorizontalAlignment="Center" Padding="40,0">
			
			<Canvas Width="520">
				<ItemsControl x:Name="ItemsListControl" HorizontalAlignment="Center">
					<ItemsControl.RenderTransform>
						<TranslateTransform x:Name="ItemsListTransform" Y="0" />
					</ItemsControl.RenderTransform>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid Height="70" Width="520">
								<Grid.Effect>
									<DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.35" />
								</Grid.Effect>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<Grid x:Name="ItemIconHost" Width="36" Height="36" VerticalAlignment="Center" Opacity="0.55">

									<Border x:Name="PlaceholderBackground"
									        CornerRadius="6"
									        Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
										<Border.Background>
											<SolidColorBrush Color="{Binding CoverAccentColor}" />
										</Border.Background>
									</Border>

									<TextBlock Text="{Binding CoverLabel}"
                                           Foreground="White"
                                           FontFamily="Segoe UI"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="4"
                                           Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />

									<Image Source="{Binding CoverImagePath}"
                                       Stretch="Uniform"
                                       Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}}" />
								</Grid>

								<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
									<TextBlock x:Name="ItemNameText"
                                           Text="{Binding Name}"
                                           Foreground="White"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           Opacity="0.55" />
									<TextBlock x:Name="ItemSubtitleText"
                                           Text="{Binding Subtitle}"
                                           Foreground="#C9D8EE"
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           Opacity="0"
                                           Margin="0,2,0,0" />
								</StackPanel>
							</Grid>
							<DataTemplate.Triggers>

								<DataTrigger Binding="{Binding IsSelected}" Value="True">
									<Setter TargetName="ItemIconHost" Property="Width" Value="50" />
									<Setter TargetName="ItemIconHost" Property="Height" Value="50" />
									<Setter TargetName="ItemIconHost" Property="Opacity" Value="1" />
									<Setter TargetName="ItemNameText" Property="Opacity" Value="1" />
									<Setter TargetName="ItemNameText" Property="FontSize" Value="22" />
									<Setter TargetName="ItemNameText" Property="FontWeight" Value="SemiBold" />
									<Setter TargetName="ItemSubtitleText" Property="Opacity" Value="1" />
								</DataTrigger>

								<DataTrigger Binding="{Binding IsGameItem}" Value="True">
									<Setter TargetName="ItemIconHost" Property="Width" Value="80" />
									<Setter TargetName="ItemIconHost" Property="Height" Value="44" />
								</DataTrigger>
								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition Binding="{Binding IsGameItem}" Value="True" />
										<Condition Binding="{Binding IsSelected}" Value="True" />
									</MultiDataTrigger.Conditions>
									<Setter TargetName="ItemIconHost" Property="Width" Value="113" />
									<Setter TargetName="ItemIconHost" Property="Height" Value="62" />
								</MultiDataTrigger>

								<DataTrigger Binding="{Binding IsActiveUser}" Value="True">
									<Setter TargetName="ItemIconHost" Property="Effect">
										<Setter.Value>
											<DropShadowEffect Color="#2F7FFF" Direction="0" ShadowDepth="0" BlurRadius="30" Opacity="1" />
										</Setter.Value>
									</Setter>
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Canvas>
		</Border>

		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,34">
			<TextBlock FontSize="13" FontFamily="Segoe UI" Foreground="#99FFFFFF" Opacity="0.6">
                <Run Text="&#x2190; &#x2192; Category" /><Run Text="    " />
                <Run Text="&#x2191; &#x2193; Item" /><Run Text="    " />
                <Run Text="Enter / A  Select" /><Run Text="    " />
                <Run Text="Esc / B  Back to Catalyst" />
			</TextBlock>
		</StackPanel>

		<views:ScreenshotViewerOverlay x:Name="ScreenshotViewer" Grid.RowSpan="5" />
	</Grid>
</UserControl>
