<UserControl x:Class="ProjectCatalyst.Views.CatalystMessageBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Focusable="False"
             KeyDown="OnKeyDown">

	<Grid>
		<Border x:Name="Backdrop" Background="#CC05070D" Opacity="0" />

        <Border x:Name="Card"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Width="560"
                MinHeight="230"
                Padding="44,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="10" BlurRadius="40" Opacity="0.5" />
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.94" ScaleY="0.94" />
            </Border.RenderTransform>

            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Ellipse x:Name="IconDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="IconLabel"
                               Text="INFO"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TitleTextBlock"
                           Text="Title"
                           Style="{StaticResource TitleText}"
                           FontSize="26"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="MessageTextBlock"
                           Text="Message"
                           FontSize="16"
                           FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30" />

                <StackPanel x:Name="ButtonPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
