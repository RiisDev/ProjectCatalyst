<Window x:Class="ProjectCatalyst.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectCatalyst.Views"
        Title="Project Catalyst"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Loaded="OnWindowLoaded"
        KeyDown="OnWindowKeyDown">

    <Grid>

        <Grid x:Name="LauncherRoot">
			<Grid.RowDefinitions>
				<RowDefinition Height="0.14*" />
                <RowDefinition Height="0.72*" />
                <RowDefinition Height="0.14*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="60,0">
                <TextBlock Text="PROJECT CATALYST"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" />

				<StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
					<Button Content="Test Alert"
                            Style="{StaticResource CatalystButton}"
                            Margin="0,0,16,0"
                            Click="OnTestAlertClick" />

                    <Button Content="Test Download"
                            Style="{StaticResource CatalystButton}"
                            Margin="0,0,16,0"
                            Click="OnTestDownloadClick" />

                    <Button Content="Clear Config"
                            Style="{StaticResource CatalystButton}"
                            BorderBrush="{StaticResource ErrorBrush}"
                            Foreground="{StaticResource ErrorBrush}"
                            Margin="0,0,30,0"
                            Click="OnClearConfigClick" />

                    <TextBlock x:Name="ClockText"
                               VerticalAlignment="Center"
                               FontSize="22"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="PlatformSelector"
                         Grid.Row="0"
                         VerticalAlignment="Center"
                         Style="{StaticResource PlatformListBoxStyle}"
                         ItemsSource="{Binding Platforms}"
                         SelectionChanged="OnPlatformSelectionChanged"
                         PreviewKeyDown="OnPlatformSelectorPreviewKeyDown" />

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,50,0,0">
                    <TextBlock x:Name="SelectedNameText"
                               Style="{StaticResource TitleText}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="SelectedSubtitleText"
                               Style="{StaticResource SubtitleText}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource PanelBorderBrush}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#x2190; &#x2192;  Navigate" Style="{StaticResource HintText}" Margin="0,0,40,0" />
                    <TextBlock Text="Enter / A  Select" Style="{StaticResource HintText}" Margin="0,0,40,0" />
                    <TextBlock Text="S / Start  Settings" Style="{StaticResource HintText}" Margin="0,0,40,0" />
                    <TextBlock Text="Esc  Exit" Style="{StaticResource HintText}" />
                </StackPanel>
            </Border>
        </Grid>

        <ContentControl x:Name="ConsoleHost" Focusable="False" Visibility="Collapsed" />

        <views:DownloadOverlay x:Name="DownloadOverlayControl" />

        <views:EmulatorSetupOverlay x:Name="EmulatorSetupControl" />

        <views:CatalystMessageBox x:Name="CatalystMessageBoxControl" />
    </Grid>
</Window>
